<Window x:Class="CombatSimulation.Views.TargetSystemEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}"
        Width="620"
        Height="480"
        MinWidth="620"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <!-- 弹窗背景改为低饱和深色渐变，取消 pop.png，避免背景纹理干扰表单控件识别。 -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#061225" Offset="0" />
            <GradientStop Color="#0B1B31" Offset="0.58" />
            <GradientStop Color="#07101F" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <Style x:Key="DialogLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>

        <Style x:Key="DialogColonStyle" TargetType="TextBlock">
            <Setter Property="Text" Value=":" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>

        <Style x:Key="DialogTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Background" Value="#CC0F172A" />
            <Setter Property="BorderBrush" Value="#546784" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,0" />
        </Style>

        <Style x:Key="DialogDescriptionTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DialogTextBoxStyle}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="MinHeight" Value="112" />
        </Style>

        <Style x:Key="ReadOnlyDisplayBoxStyle" TargetType="Border">
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="#771E293B" />
            <Setter Property="BorderBrush" Value="#546784" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,0" />
        </Style>

        <Style x:Key="ReadOnlyDisplayTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#CBD5E1" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="112" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#F6E84A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#93C5FD" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Foreground" Value="#93C5FD" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Margin="22"
            Padding="22"
            Background="#E60B1626"
            BorderBrush="#42526A"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding DialogTitle}"
                       Foreground="#F8FAFC"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Margin="0,0,0,22" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="系统名称" Style="{StaticResource DialogLabelStyle}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DialogColonStyle}" />
                <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding SystemName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DialogTextBoxStyle}" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="父系统" Style="{StaticResource DialogLabelStyle}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DialogColonStyle}" />
                <Border Grid.Row="1" Grid.Column="2" Style="{StaticResource ReadOnlyDisplayBoxStyle}">
                    <TextBlock Text="{Binding ParentSystemDisplayText}" Style="{StaticResource ReadOnlyDisplayTextStyle}" />
                </Border>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="顶系统" Style="{StaticResource DialogLabelStyle}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DialogColonStyle}" />
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource ReadOnlyDisplayBoxStyle}">
                    <TextBlock Text="{Binding IsTopSystemDisplayText}" Style="{StaticResource ReadOnlyDisplayTextStyle}" />
                </Border>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="系统描述" Style="{StaticResource DialogLabelStyle}" VerticalAlignment="Top" Margin="0,6,4,0" />
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DialogColonStyle}" VerticalAlignment="Top" Margin="0,6,0,0" />
                <TextBox Grid.Row="3"
                         Grid.Column="2"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         Style="{StaticResource DialogDescriptionTextBoxStyle}"
                         Text="{Binding SystemDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>

            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Center"
                        Margin="0,24,0,0">
                <TextBlock Text="{Binding ValidationMessage}"
                           Foreground="#FF6B6B"
                           FontSize="14"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,8">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Content="保存并退出"
                            Style="{StaticResource DialogButtonStyle}"
                            Command="{Binding SaveCommand}" />
                    <Button Content="取消"
                            Style="{StaticResource DialogButtonStyle}"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
