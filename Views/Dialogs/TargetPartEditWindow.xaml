<dialogs:DialogWindowBase x:Class="CombatSimulation.Views.TargetPartEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:CombatSimulation.Views.Dialogs"
        Title="{Binding DialogTitle}"
        Width="1060"
        Height="900"
        MinWidth="1060"
        MinHeight="900"
        MaxWidth="1060"
        MaxHeight="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource DialogWindowStyle}">
    <dialogs:DialogWindowBase.Resources>
        <!-- 部件颜色下拉框专用显示模板：左侧色块 + 右侧颜色名称。 -->
        <DataTemplate x:Key="ColorOptionTemplate">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="76"
                        Height="16"
                        Margin="0,0,10,0"
                        Background="{Binding Value}"
                        BorderBrush="#AACBD5E1"
                        BorderThickness="1" />
                <TextBlock Text="{Binding Value}"
                           Foreground="#F8FAFC"
                           FontSize="16"
                           VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </dialogs:DialogWindowBase.Resources>

<!-- 弹窗外层容器：面板颜色、边框和内边距集中在 DialogShellBorderStyle。 -->
    <Border Style="{StaticResource DialogShellBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding DialogTitle}" Style="{StaticResource DialogTitleTextStyle}" Margin="0,0,0,18" />

            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <GroupBox Header="基本信息"
                              Foreground="#F8FAFC"
                              Background="#990F172A"
                              BorderBrush="#546784"
                              FontSize="16"
                              Margin="32,0,32,18"
                              Padding="18">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="126" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="210" />
                                <ColumnDefinition Width="28" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="210" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" />
                                <RowDefinition Height="42" />
                                <RowDefinition Height="42" />
                                <RowDefinition Height="102" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="等效部件名称" Style="{StaticResource DialogLabelStyle}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DialogColonStyle}" />
                            <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding PartName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DialogTextBoxStyle}" />

                            <TextBlock Grid.Row="0" Grid.Column="4" Text="等效材料" Style="{StaticResource DialogLabelStyle}" />
                            <TextBlock Grid.Row="0" Grid.Column="5" Style="{StaticResource DialogColonStyle}" />
                            <ComboBox Grid.Row="0"
                                      Grid.Column="6"
                                      IsEditable="False"
                                      ItemsSource="{Binding MaterialOptions}"
                                      SelectedItem="{Binding SelectedMaterial, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{StaticResource DialogComboBoxStyle}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="等效厚度(mm)" Style="{StaticResource DialogLabelStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DialogColonStyle}" />
                            <TextBox Grid.Row="1"
                                     Grid.Column="2"
                                     Text="{Binding EquivalentThicknessText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource NumericTextBoxStyle}" />

                            <TextBlock Grid.Row="1" Grid.Column="4" Text="显示颜色" Style="{StaticResource DialogLabelStyle}" />
                            <TextBlock Grid.Row="1" Grid.Column="5" Style="{StaticResource DialogColonStyle}" />
                            <ComboBox Grid.Row="1"
                                      Grid.Column="6"
                                      IsEditable="False"
                                      ItemsSource="{Binding ColorOptions}"
                                      SelectedValue="{Binding SelectedDisplayColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      SelectedValuePath="Value"
                                      ItemTemplate="{StaticResource ColorOptionTemplate}"
                                      Style="{StaticResource DialogComboBoxStyle}" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="易损面积" Style="{StaticResource DialogLabelStyle}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DialogColonStyle}" />
                            <TextBox Grid.Row="2"
                                     Grid.Column="2"
                                     Text="{Binding VulnerableAreaText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource NumericTextBoxStyle}" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="部件描述" Style="{StaticResource DialogLabelStyle}" VerticalAlignment="Top" Margin="0,6,0,0" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DialogColonStyle}" VerticalAlignment="Top" Margin="0,6,0,0" />
                            <TextBox Grid.Row="3"
                                     Grid.Column="2"
                                     Grid.ColumnSpan="5"
                                     Style="{StaticResource DialogDescriptionTextBoxStyle}"
                                     Text="{Binding PartDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </Grid>
                    </GroupBox>

                    <GroupBox Header="部件参数"
                              Foreground="#F8FAFC"
                              Background="#990F172A"
                              BorderBrush="#546784"
                              FontSize="16"
                              Margin="32,0,32,0"
                              Padding="18">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="126" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="210" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="等效形状" Style="{StaticResource DialogLabelStyle}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource DialogColonStyle}" />
                                <ComboBox Grid.Column="2"
                                          IsEditable="False"
                                          ItemsSource="{Binding ShapeTypeOptions}"
                                          SelectedItem="{Binding SelectedShapeType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{StaticResource DialogComboBoxStyle}" />
                            </Grid>

                            <TextBlock Text="形状参数" Style="{StaticResource SectionTitleTextStyle}" />
                            <ItemsControl ItemsSource="{Binding Parameters}"
                                          Margin="0,0,0,2">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,0,10,10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="112" />
                                                <ColumnDefinition Width="14" />
                                                <ColumnDefinition Width="130" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" Style="{StaticResource DialogLabelStyle}" />
                                            <TextBlock Grid.Column="1" Style="{StaticResource DialogColonStyle}" />
                                            <TextBox Grid.Column="2"
                                                     Text="{Binding ValueText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource NumericTextBoxStyle}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <StackPanel>
                                <StackPanel.Style>
                                    <Style TargetType="StackPanel">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTransformVisible}" Value="False">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </StackPanel.Style>
                                <TextBlock Text="中心坐标" Style="{StaticResource SectionTitleTextStyle}" />
                                <UniformGrid Columns="3" Margin="0,0,0,2">
                                    <Grid Margin="0,0,10,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="130" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="X(mm)" Style="{StaticResource DialogLabelStyle}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource DialogColonStyle}" />
                                        <TextBox Grid.Column="2" Text="{Binding CenterXText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBoxStyle}" />
                                    </Grid>
                                    <Grid Margin="0,0,10,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="130" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Y(mm)" Style="{StaticResource DialogLabelStyle}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource DialogColonStyle}" />
                                        <TextBox Grid.Column="2" Text="{Binding CenterYText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBoxStyle}" />
                                    </Grid>
                                    <Grid Margin="0,0,10,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="130" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Z(mm)" Style="{StaticResource DialogLabelStyle}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource DialogColonStyle}" />
                                        <TextBox Grid.Column="2" Text="{Binding CenterZText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBoxStyle}" />
                                    </Grid>
                                </UniformGrid>

                                <TextBlock Text="旋转角度" Style="{StaticResource SectionTitleTextStyle}" />
                                <UniformGrid Columns="3">
                                    <Grid Margin="0,0,10,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="130" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="X(°)" Style="{StaticResource DialogLabelStyle}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource DialogColonStyle}" />
                                        <TextBox Grid.Column="2" Text="{Binding RotationXText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBoxStyle}" />
                                    </Grid>
                                    <Grid Margin="0,0,10,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="130" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Y(°)" Style="{StaticResource DialogLabelStyle}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource DialogColonStyle}" />
                                        <TextBox Grid.Column="2" Text="{Binding RotationYText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBoxStyle}" />
                                    </Grid>
                                    <Grid Margin="0,0,10,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="112" />
                                            <ColumnDefinition Width="14" />
                                            <ColumnDefinition Width="130" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Z(°)" Style="{StaticResource DialogLabelStyle}" />
                                        <TextBlock Grid.Column="1" Style="{StaticResource DialogColonStyle}" />
                                        <TextBox Grid.Column="2" Text="{Binding RotationZText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource NumericTextBoxStyle}" />
                                    </Grid>
                                </UniformGrid>
                            </StackPanel>
                        </StackPanel>
                    </GroupBox>
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="2"
                        HorizontalAlignment="Center"
                        Margin="0,8,0,8">
                <TextBlock Text="{Binding ValidationMessage}" Style="{StaticResource DialogValidationTextStyle}" />

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center">
                    <Button Content="保存并退出"
                            Style="{StaticResource DialogButtonStyle}"
                            Command="{Binding SaveCommand}" />
                    <Button Content="取消"
                            Style="{StaticResource DialogButtonStyle}"
                            Command="{Binding CancelCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</dialogs:DialogWindowBase>
