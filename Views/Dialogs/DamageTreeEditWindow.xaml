<dialogs:DialogWindowBase x:Class="CombatSimulation.Views.DamageTreeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:CombatSimulation.Views.Dialogs"
        Title="{Binding DialogTitle}"
        Width="640"
        Height="640"
        MinWidth="640"
        MinHeight="640"
        MaxWidth="640"
        MaxHeight="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource DialogWindowStyle}">
    <!-- 弹窗外层容器：面板颜色、边框和内边距集中在 DialogShellBorderStyle。 -->
    <Border Style="{StaticResource DialogShellBorderStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="50" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding DialogTitle}" Style="{StaticResource DialogTitleTextStyle}" Margin="0,0,0,20" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="102" />
                    <RowDefinition Height="102" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="对应目标" Style="{StaticResource DialogLabelStyle}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DialogColonStyle}" />
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource ReadOnlyDisplayBoxStyle}">
                    <TextBlock Text="{Binding TargetDisplayName}" Foreground="#CBD5E1" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="毁伤树名称*" Style="{StaticResource DialogLabelStyle}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DialogColonStyle}" />
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding DamageTreeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DialogTextBoxStyle}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="毁伤等级" Style="{StaticResource DialogLabelStyle}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DialogColonStyle}" />
                <ComboBox Grid.Row="2"
                          Grid.Column="2"
                          ItemsSource="{Binding DamageLevelOptions}"
                          SelectedItem="{Binding DamageLevelInfo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource DialogComboBoxStyle}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="毁伤树类型" Style="{StaticResource DialogLabelStyle}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DialogColonStyle}" />
                <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource ReadOnlyDisplayBoxStyle}">
                    <TextBlock Text="{Binding DamageTreeType}" Foreground="#CBD5E1" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="根节点名称*" Style="{StaticResource DialogLabelStyle}" />
                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource DialogColonStyle}" />
                <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding RootNodeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DialogTextBoxStyle}" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="根节点描述" Style="{StaticResource DialogLabelStyle}" VerticalAlignment="Top" Margin="0,6,4,0" />
                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource DialogColonStyle}" VerticalAlignment="Top" Margin="0,6,0,0" />
                <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding RootNodeDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DialogDescriptionTextBoxStyle}" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="毁伤树描述" Style="{StaticResource DialogLabelStyle}" VerticalAlignment="Top" Margin="0,6,4,0" />
                <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource DialogColonStyle}" VerticalAlignment="Top" Margin="0,6,0,0" />
                <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding DamageTreeDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DialogDescriptionTextBoxStyle}" />
            </Grid>

            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Orientation="Horizontal" Margin="0,8,0,8">
                <Button Content="保存并退出" Style="{StaticResource DialogButtonStyle}" Command="{Binding SaveCommand}" />
                <Button Content="取消" Style="{StaticResource DialogButtonStyle}" Command="{Binding CancelCommand}" />
            </StackPanel>
        </Grid>
    </Border>
</dialogs:DialogWindowBase>
