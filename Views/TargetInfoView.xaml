<UserControl x:Class="CombatSimulation.Views.TargetInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CombatSimulation.Views"
             MinWidth="800"
             MinHeight="500">

    <UserControl.Resources>
        <ResourceDictionary Source="../Resources/Styles/TargetInfoViewStyles.xaml" />
    </UserControl.Resources>

    <Grid>
        <Grid IsEnabled="{Binding IsDatabaseReady}">
        <!--定义两列 第一列为目标总览信息，第二列为具体信息-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：目标列表 -->
        <Border Grid.Column="0"
                Style="{DynamicResource CardStyle}"
                Margin="0,0,16,0">

            <DockPanel>
                <StackPanel DockPanel.Dock="Top"
                            Margin="0,0,0,12">
                    <TextBlock Text="典型目标列表"
                               FontSize="20"
                               FontWeight="Bold" />

                    <StackPanel Orientation="Horizontal"
                                Margin="0,10,0,0">
                        <Button Content="添加目标"
                                Style="{StaticResource TargetTextActionButtonStyle}"
                                Command="{Binding RequestAddTargetCommand}" />
                        <Button Content="修改目标"
                                Style="{StaticResource TargetTextActionButtonStyle}"
                                Command="{Binding RequestModifyTargetCommand}" />
                        <Button Content="删除目标"
                                Style="{StaticResource TargetTextActionButtonStyle}"
                                Command="{Binding RequestDeleteTargetCommand}" />
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Top"
                        Margin="0,0,0,16"
                        Padding="12"
                        Background="#661E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="目标类型"
                                   Foreground="#E2E8F0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <ComboBox ItemsSource="{Binding TargetCategories}"
                                  SelectedItem="{Binding SelectedTargetCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{DynamicResource TargetTypeComboBoxStyle}"
                                  ItemContainerStyle="{DynamicResource TargetTypeComboBoxItemStyle}" />
                    </StackPanel>
                </Border>

                <Border DockPanel.Dock="Bottom"
                        Margin="0,12,0,0"
                        Padding="10,8"
                        Background="#661E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="8">
                    <TextBlock Text="{Binding StatusText}"
                               Foreground="#BFD4F5"
                               TextWrapping="Wrap"
                               ToolTip="{Binding StatusText}" />
                </Border>
                <!--显示的目标列表，绑定通过上面的下拉框选中的类型的所有目标-->
                <ListBox ItemsSource="{Binding FilteredTargets}"
                         SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                         SelectionMode="Single"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.PanningMode="VerticalFirst"
                         ItemContainerStyle="{DynamicResource TargetItemListBoxItemStyle}">
                    <!-- 滚动条样式统一由 App.xaml 的 TargetListScrollBarStyle 提供。 -->

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#F8FAFC" />
                                <TextBlock Text="{Binding Code}"
                                           Foreground="#BFD4F5"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Category}"
                                           Foreground="#8FB7FF" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右侧：结构信息 / 毁伤树信息 -->
        <Border Grid.Column="1"
                Style="{DynamicResource CardStyle}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 子页面切换按钮 -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="0,0,0,18">

                    <ToggleButton Content="目标结构信息"
                                  Style="{DynamicResource SegmentButtonStyle}"
                                  IsChecked="{Binding IsStructureInfoSelected, Mode=OneWay}"
                                  Command="{Binding ShowStructureInfoCommand}" />

                    <ToggleButton Content="毁伤树信息"
                                  Style="{DynamicResource SegmentButtonStyle}"
                                  IsChecked="{Binding IsDamageTreeInfoSelected, Mode=OneWay}"
                                  Command="{Binding ShowDamageTreeInfoCommand}" />
                </StackPanel>

                <!-- 子页面内容区 -->
                <Grid Grid.Row="1">

                    <!-- 目标结构信息：内部包含 Unity 区域 -->
                    <views:TargetStructureInfoView Visibility="{Binding StructureInfoVisibility}" />

                    <!-- 毁伤树信息：内部不包含 Unity 区域 -->
                    <views:TargetDamageTreeInfoView Visibility="{Binding DamageTreeInfoVisibility}" />

                </Grid>
            </Grid>
        </Border>
        </Grid>

        <Border Panel.ZIndex="10"
                Background="#E60F172A">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDatabaseReady}" Value="False">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <StackPanel Width="360"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ProgressBar Height="4"
                             IsIndeterminate="True"
                             Foreground="#38BDF8"
                             Background="#334155" />
                <TextBlock Margin="0,16,0,0"
                           Text="{Binding StatusText}"
                           Foreground="#EAF6FF"
                           FontSize="16"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>