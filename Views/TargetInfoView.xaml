<UserControl x:Class="CombatSimulation.Views.TargetInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:CombatSimulation.ViewModels"
             xmlns:views="clr-namespace:CombatSimulation.Views"
             MinWidth="800"
             MinHeight="500">

    <UserControl.DataContext>
        <viewModels:TargetInfoViewModel />
    </UserControl.DataContext>

    <UserControl.Resources>
        <!--目标信息增删改按钮风格-->
        <Style x:Key="TargetTextActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="76" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F6E84A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FF3B30" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Foreground" Value="#FF3B30" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="#64748B" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid IsEnabled="{Binding IsDatabaseReady}">
        <!--定义两列 第一列为目标总览信息，第二列为具体信息-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左侧：目标列表 -->
        <Border Grid.Column="0"
                Style="{DynamicResource CardStyle}"
                Margin="0,0,16,0">

            <DockPanel>
                <StackPanel DockPanel.Dock="Top"
                            Margin="0,0,0,12">
                    <TextBlock Text="典型目标列表"
                               FontSize="20"
                               FontWeight="Bold" />

                    <StackPanel Orientation="Horizontal"
                                Margin="0,10,0,0">
                        <Button Content="添加目标"
                                Style="{StaticResource TargetTextActionButtonStyle}"
                                Command="{Binding RequestAddTargetCommand}" />
                        <Button Content="修改目标"
                                Style="{StaticResource TargetTextActionButtonStyle}"
                                Command="{Binding RequestModifyTargetCommand}" />
                        <Button Content="删除目标"
                                Style="{StaticResource TargetTextActionButtonStyle}"
                                Command="{Binding RequestDeleteTargetCommand}" />
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Top"
                        Margin="0,0,0,16"
                        Padding="12"
                        Background="#661E293B"
                        BorderBrush="#334155"
                        BorderThickness="1"
                        CornerRadius="12">
                    <StackPanel>
                        <TextBlock Text="目标类型"
                                   Foreground="#E2E8F0"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,8" />

                        <ComboBox ItemsSource="{Binding TargetCategories}"
                                  SelectedItem="{Binding SelectedTargetCategory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{DynamicResource TargetTypeComboBoxStyle}"
                                  ItemContainerStyle="{DynamicResource TargetTypeComboBoxItemStyle}" />
                    </StackPanel>
                </Border>

                <!--显示的目标列表，绑定通过上面的下拉框选中的类型的所有目标-->
                <ListBox ItemsSource="{Binding FilteredTargets}"
                         SelectedItem="{Binding SelectedTarget, Mode=TwoWay}"
                         SelectionMode="Single"
                         Background="Transparent"
                         BorderThickness="0"
                         Padding="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.PanningMode="VerticalFirst"
                         ItemContainerStyle="{DynamicResource TargetItemListBoxItemStyle}">
                    <!-- 滚动条样式统一由 App.xaml 的 TargetListScrollBarStyle 提供。 -->

                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="#F8FAFC" />
                                <TextBlock Text="{Binding Code}"
                                           Foreground="#BFD4F5"
                                           Margin="0,4,0,0" />
                                <TextBlock Text="{Binding Category}"
                                           Foreground="#8FB7FF" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- 右侧：结构信息 / 毁伤树信息 -->
        <Border Grid.Column="1"
                Style="{DynamicResource CardStyle}">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- 子页面切换按钮 -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="0,0,0,18">

                    <ToggleButton Content="目标结构信息"
                                  Style="{DynamicResource SegmentButtonStyle}"
                                  IsChecked="{Binding IsStructureInfoSelected, Mode=OneWay}"
                                  Command="{Binding ShowStructureInfoCommand}" />

                    <ToggleButton Content="毁伤树信息"
                                  Style="{DynamicResource SegmentButtonStyle}"
                                  IsChecked="{Binding IsDamageTreeInfoSelected, Mode=OneWay}"
                                  Command="{Binding ShowDamageTreeInfoCommand}" />
                </StackPanel>

                <!-- 子页面内容区 -->
                <Grid Grid.Row="1">

                    <!-- 目标结构信息：内部包含 Unity 区域 -->
                    <views:TargetStructureInfoView Visibility="{Binding StructureInfoVisibility}" />

                    <!-- 毁伤树信息：内部不包含 Unity 区域 -->
                    <views:TargetDamageTreeInfoView Visibility="{Binding DamageTreeInfoVisibility}" />

                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>