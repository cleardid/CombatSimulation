<UserControl x:Class="CombatSimulation.Views.CombatDeductionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:CombatSimulation.ViewModels"
             MinWidth="800"
             MinHeight="500">

    <UserControl.DataContext>
        <viewModels:CombatDeductionViewModel />
    </UserControl.DataContext>

    <Grid>
        <Border Style="{DynamicResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="190" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 顶部标题与控制按钮 -->
                <DockPanel Grid.Row="0"
                           Margin="0,0,0,18">

                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal">

                        <Button Content="开始推演"
                                Width="110"
                                Height="34"
                                Margin="0,0,10,0"
                                Command="{Binding StartDeductionCommand}" />

                        <Button Content="暂停"
                                Width="90"
                                Height="34"
                                Margin="0,0,10,0"
                                Command="{Binding PauseDeductionCommand}" />

                        <Button Content="复位"
                                Width="90"
                                Height="34"
                                Command="{Binding ResetDeductionCommand}" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="作战推演"
                                   FontSize="24"
                                   FontWeight="Bold" />

                        <TextBlock Text="执行推演启动、暂停、复位，并展示当前推演态势与事件日志。"
                                   FontSize="14"
                                   Foreground="#BFD4F5"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- 中间主体区域 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：推演状态 -->
                    <Border Grid.Column="0"
                            Background="#AA0B1220"
                            BorderBrush="#26384F"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18"
                            Margin="0,0,16,0">

                        <StackPanel>
                            <TextBlock Text="推演状态"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0,0,0,18" />

                            <TextBlock Text="{Binding SimulationState, StringFormat=运行状态：{0}}"
                                       FontSize="15"
                                       Foreground="#BFD4F5"
                                       Margin="0,0,0,10" />

                            <TextBlock Text="{Binding CurrentPhase, StringFormat=当前阶段：{0}}"
                                       FontSize="15"
                                       Foreground="#BFD4F5"
                                       Margin="0,0,0,10" />

                            <TextBlock Text="{Binding ElapsedTimeText, StringFormat=推演时间：{0}}"
                                       FontSize="15"
                                       Foreground="#BFD4F5"
                                       Margin="0,0,0,18" />

                            <TextBlock Text="推演进度"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Margin="0,0,0,8" />

                            <ProgressBar Minimum="0"
                                         Maximum="100"
                                         Value="{Binding ProgressValue, Mode=OneWay}"
                                         Height="18"
                                         Margin="0,0,0,8" />

                            <TextBlock Text="{Binding ProgressText}"
                                       Foreground="#F8FAFC"
                                       HorizontalAlignment="Right"
                                       Margin="0,0,0,22" />

                            <Border Background="#CC1F2937"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,0,0,12">

                                <StackPanel>
                                    <TextBlock Text="蓝方状态"
                                               FontWeight="Bold"
                                               Margin="0,0,0,6" />

                                    <TextBlock Text="{Binding BlueForceStatus}"
                                               Foreground="#BFD4F5"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border Background="#CC1F2937"
                                    CornerRadius="8"
                                    Padding="12">

                                <StackPanel>
                                    <TextBlock Text="红方状态"
                                               FontWeight="Bold"
                                               Margin="0,0,0,6" />

                                    <TextBlock Text="{Binding RedForceStatus}"
                                               Foreground="#BFD4F5"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 右侧：态势显示区域 -->
                    <Border Grid.Column="1"
                            Background="#AA050A12"
                            BorderBrush="#26384F"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="18">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="战场态势显示"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0,0,0,14" />

                            <Border Grid.Row="1"
                                    Background="#66000000"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="20">

                                <Grid>
                                    <TextBlock Text="此区域预留为二维/三维态势显示宿主位。&#x0a;后续可接入地图、Unity 视图或自定义态势控件。"
                                               Foreground="#BFD4F5"
                                               FontSize="16"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </Border>

                            <Border Grid.Row="2"
                                    Background="#CC1F2937"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,16,0,0">

                                <StackPanel>
                                    <TextBlock Text="当前态势"
                                               FontWeight="Bold"
                                               Margin="0,0,0,6" />

                                    <TextBlock Text="{Binding BattlefieldStatus}"
                                               Foreground="#BFD4F5"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 下方：事件日志 -->
                <Border Grid.Row="2"
                        Background="#AA0B1220"
                        BorderBrush="#26384F"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="14"
                        Margin="0,16,0,0">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="推演事件日志"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10" />

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding EventLogs}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  Background="#66050A12"
                                  Foreground="#F8FAFC"
                                  RowBackground="#33111827"
                                  AlternatingRowBackground="#551F2937"
                                  BorderBrush="#26384F"
                                  BorderThickness="1">

                            <DataGrid.Columns>
                                <DataGridTextColumn Header="时间"
                                                    Binding="{Binding TimeText}"
                                                    Width="110" />

                                <DataGridTextColumn Header="阶段"
                                                    Binding="{Binding Phase}"
                                                    Width="140" />

                                <DataGridTextColumn Header="事件内容"
                                                    Binding="{Binding Content}"
                                                    Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- 底部状态栏 -->
                <Border Grid.Row="3"
                        Background="#CC1F2937"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,16,0,0">

                    <TextBlock Text="{Binding ModuleStatusText}"
                               Foreground="#F8FAFC"
                               FontSize="14"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>