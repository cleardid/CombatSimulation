<Window x:Class="CombatSimulation.Views.DamageTreeEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding DialogTitle}"
        Width="640"
        Height="560"
        MinWidth="640"
        MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <!-- 弹窗背景改为低饱和深色渐变，取消 pop.png，避免背景纹理干扰表单控件识别。 -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#061225" Offset="0" />
            <GradientStop Color="#0B1B31" Offset="0.58" />
            <GradientStop Color="#07101F" Offset="1" />
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <Style x:Key="DialogLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="Margin" Value="0,0,4,0" />
        </Style>
        <Style x:Key="DialogColonStyle" TargetType="TextBlock">
            <Setter Property="Text" Value=":" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="DialogTextBoxStyle" TargetType="TextBox">
            <Setter Property="Height" Value="30" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Background" Value="#CC0F172A" />
            <Setter Property="BorderBrush" Value="#546784" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style x:Key="DialogDescriptionTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource DialogTextBoxStyle}">
            <Setter Property="Height" Value="Auto" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="AcceptsReturn" Value="True" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>

        <!--
            弹窗下拉框专用深色模板。
            使用完整 ControlTemplate 并设置 OverridesDefaultStyle，避免系统 ComboBox 在展开或失焦时回退为白底。
        -->
        <ControlTemplate x:Key="DialogComboBoxDropDownToggleTemplate" TargetType="ToggleButton">
            <Border Background="Transparent" />
        </ControlTemplate>

        <Style x:Key="DialogComboBoxItemStyle" TargetType="ComboBoxItem">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}"
                                TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#5538BDF8" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="#6638BDF8" />
                                <Setter Property="Foreground" Value="#F8FAFC" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogComboBoxStyle" TargetType="ComboBox">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Padding" Value="12,0,36,0" />
            <Setter Property="Foreground" Value="#F8FAFC" />
            <Setter Property="Background" Value="#CC0F172A" />
            <Setter Property="BorderBrush" Value="#546784" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="MaxDropDownHeight" Value="180" />
            <Setter Property="ItemContainerStyle" Value="{StaticResource DialogComboBoxItemStyle}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="RootBorder"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6">
                                <Grid>
                                    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                                                      Margin="{TemplateBinding Padding}"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="Center"
                                                      TextElement.Foreground="{TemplateBinding Foreground}"
                                                      TextElement.FontSize="{TemplateBinding FontSize}"
                                                      TextElement.FontWeight="{TemplateBinding FontWeight}" />
                                    <Path x:Name="Arrow"
                                          Data="M 0 0 L 8 8 L 16 0"
                                          Stroke="#D7E7F7"
                                          StrokeThickness="1.7"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Width="13"
                                          Height="7"
                                          Stretch="Fill"
                                          HorizontalAlignment="Right"
                                          VerticalAlignment="Center"
                                          Margin="0,0,12,0"
                                          RenderTransformOrigin="0.5,0.5" />
                                </Grid>
                            </Border>
                            <ToggleButton x:Name="DropDownToggle"
                                          Template="{StaticResource DialogComboBoxDropDownToggleTemplate}"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Grid MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                      Margin="0,5,0,0">
                                    <Border Background="#F20B1626"
                                            BorderBrush="#546784"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="4">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.32" />
                                        </Border.Effect>
                                        <ScrollViewer CanContentScroll="False" SnapsToDevicePixels="True">
                                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                        </ScrollViewer>
                                    </Border>
                                </Grid>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#DD1E293B" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="#7DD3FC" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="#38BDF8" />
                            </Trigger>
                            <Trigger Property="IsDropDownOpen" Value="True">
                                <Setter TargetName="RootBorder" Property="Background" Value="#EE1E293B" />
                                <Setter TargetName="RootBorder" Property="BorderBrush" Value="#38BDF8" />
                                <Setter TargetName="Arrow" Property="RenderTransform">
                                    <Setter.Value>
                                        <RotateTransform Angle="180" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="RootBorder" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 本窗口内未显式设置样式的 ComboBox 也强制使用深色模板，防止遗漏后出现白底。 -->
        <Style TargetType="ComboBox" BasedOn="{StaticResource DialogComboBoxStyle}" />

        <Style x:Key="ReadOnlyDisplayBoxStyle" TargetType="Border">
            <Setter Property="Height" Value="30" />
            <Setter Property="Background" Value="#660F172A" />
            <Setter Property="BorderBrush" Value="#546784" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="6,0" />
        </Style>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="112" />
            <Setter Property="Height" Value="34" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Foreground" Value="#F6E84A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="14,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#93C5FD" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="#93C5FD" /></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border Margin="22" Padding="22" Background="#E60B1626" BorderBrush="#42526A" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Text="{Binding DialogTitle}" Foreground="#F8FAFC" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,20" />

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="112" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="42" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="42" />
                    <RowDefinition Height="86" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="对应目标" Style="{StaticResource DialogLabelStyle}" />
                <TextBlock Grid.Row="0" Grid.Column="1" Style="{StaticResource DialogColonStyle}" />
                <Border Grid.Row="0" Grid.Column="2" Style="{StaticResource ReadOnlyDisplayBoxStyle}">
                    <TextBlock Text="{Binding TargetDisplayName}" Foreground="#CBD5E1" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="毁伤树名称" Style="{StaticResource DialogLabelStyle}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Style="{StaticResource DialogColonStyle}" />
                <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding DamageTreeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DialogTextBoxStyle}" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="毁伤等级" Style="{StaticResource DialogLabelStyle}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Style="{StaticResource DialogColonStyle}" />
                <ComboBox Grid.Row="2"
                          Grid.Column="2"
                          ItemsSource="{Binding DamageLevelOptions}"
                          SelectedItem="{Binding DamageLevelInfo, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          Style="{StaticResource DialogComboBoxStyle}" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="毁伤树类型" Style="{StaticResource DialogLabelStyle}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Style="{StaticResource DialogColonStyle}" />
                <Border Grid.Row="3" Grid.Column="2" Style="{StaticResource ReadOnlyDisplayBoxStyle}">
                    <TextBlock Text="{Binding DamageTreeType}" Foreground="#CBD5E1" FontSize="16" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>

                <TextBlock Grid.Row="4" Grid.Column="0" Text="根节点名称" Style="{StaticResource DialogLabelStyle}" />
                <TextBlock Grid.Row="4" Grid.Column="1" Style="{StaticResource DialogColonStyle}" />
                <TextBox Grid.Row="4" Grid.Column="2" Text="{Binding RootNodeName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DialogTextBoxStyle}" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="根节点描述" Style="{StaticResource DialogLabelStyle}" VerticalAlignment="Top" Margin="0,6,4,0" />
                <TextBlock Grid.Row="5" Grid.Column="1" Style="{StaticResource DialogColonStyle}" VerticalAlignment="Top" Margin="0,6,0,0" />
                <TextBox Grid.Row="5" Grid.Column="2" Text="{Binding RootNodeDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DialogDescriptionTextBoxStyle}" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="毁伤树描述" Style="{StaticResource DialogLabelStyle}" VerticalAlignment="Top" Margin="0,6,4,0" />
                <TextBlock Grid.Row="6" Grid.Column="1" Style="{StaticResource DialogColonStyle}" VerticalAlignment="Top" Margin="0,6,0,0" />
                <TextBox Grid.Row="6" Grid.Column="2" Text="{Binding DamageTreeDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DialogDescriptionTextBoxStyle}" />
            </Grid>

            <StackPanel Grid.Row="2" HorizontalAlignment="Center" Margin="0,22,0,0">
                <TextBlock Text="{Binding ValidationMessage}" Foreground="#FF6B6B" FontSize="14" HorizontalAlignment="Center" Margin="0,0,0,8" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="保存并退出" Style="{StaticResource DialogButtonStyle}" Command="{Binding SaveCommand}" />
                    <Button Content="取消" Style="{StaticResource DialogButtonStyle}" Command="{Binding CancelCommand}" />
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
