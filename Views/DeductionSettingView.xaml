<UserControl x:Class="CombatSimulation.Views.DeductionSettingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:viewModels="clr-namespace:CombatSimulation.ViewModels"
             MinWidth="800"
             MinHeight="500">

    <UserControl.DataContext>
        <viewModels:DeductionSettingViewModel />
    </UserControl.DataContext>

    <Grid>
        <Border Style="{DynamicResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 顶部标题与操作按钮 -->
                <DockPanel Grid.Row="0"
                           Margin="0,0,0,18">

                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button Content="加载默认"
                                Width="100"
                                Height="34"
                                Margin="0,0,10,0"
                                Command="{Binding LoadDefaultCommand}" />

                        <Button Content="保存设定"
                                Width="100"
                                Height="34"
                                Margin="0,0,10,0"
                                Command="{Binding SaveSettingCommand}" />

                        <Button Content="重置"
                                Width="90"
                                Height="34"
                                Command="{Binding ResetSettingCommand}" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="推演设定"
                                   FontSize="24"
                                   FontWeight="Bold" />

                        <TextBlock Text="配置推演模式、战场环境、毁伤模型与基础推演参数。"
                                   FontSize="14"
                                   Foreground="#BFD4F5"
                                   Margin="0,8,0,0" />
                    </StackPanel>
                </DockPanel>

                <!-- 中间主体区域 -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- 左侧：基础设定 -->
                    <Border Grid.Column="0"
                            Style="{DynamicResource SubCardStyle}"
                            Margin="0,0,18,0">

                        <StackPanel>
                            <TextBlock Text="基础设定"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Margin="0,0,0,18" />

                            <TextBlock Text="推演模式"
                                       FontSize="14"
                                       Foreground="#BFD4F5"
                                       Margin="0,0,0,6" />

                            <ComboBox ItemsSource="{Binding DeductionModes}"
                                      SelectedItem="{Binding SelectedDeductionMode, Mode=TwoWay}"
                                      Height="34"
                                      Margin="0,0,0,16" />

                            <TextBlock Text="战场环境"
                                       FontSize="14"
                                       Foreground="#BFD4F5"
                                       Margin="0,0,0,6" />

                            <ComboBox ItemsSource="{Binding BattlefieldEnvironments}"
                                      SelectedItem="{Binding SelectedBattlefieldEnvironment, Mode=TwoWay}"
                                      Height="34"
                                      Margin="0,0,0,16" />

                            <TextBlock Text="毁伤模型"
                                       FontSize="14"
                                       Foreground="#BFD4F5"
                                       Margin="0,0,0,6" />

                            <ComboBox ItemsSource="{Binding DamageModels}"
                                      SelectedItem="{Binding SelectedDamageModel, Mode=TwoWay}"
                                      Height="34"
                                      Margin="0,0,0,20" />

                            <CheckBox Content="启用随机因素"
                                      IsChecked="{Binding EnableRandomFactor, Mode=TwoWay}"
                                      Foreground="#F8FAFC"
                                      FontSize="14"
                                      Margin="0,0,0,12" />

                            <CheckBox Content="启用实时日志"
                                      IsChecked="{Binding EnableRealtimeLog, Mode=TwoWay}"
                                      Foreground="#F8FAFC"
                                      FontSize="14" />

                            <Border Background="#CC1F2937"
                                    CornerRadius="8"
                                    Padding="12"
                                    Margin="0,24,0,0">

                                <StackPanel>
                                    <TextBlock Text="当前设定摘要"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Margin="0,0,0,10" />

                                    <TextBlock Text="{Binding SelectedDeductionMode, StringFormat=推演模式：{0}}"
                                               Foreground="#BFD4F5"
                                               Margin="0,0,0,6" />

                                    <TextBlock Text="{Binding SelectedBattlefieldEnvironment, StringFormat=战场环境：{0}}"
                                               Foreground="#BFD4F5"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,6" />

                                    <TextBlock Text="{Binding SelectedDamageModel, StringFormat=毁伤模型：{0}}"
                                               Foreground="#BFD4F5"
                                               TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 右侧：推演参数列表 -->
                    <Border Grid.Column="1"
                            Style="{DynamicResource SubCardStyle}">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0"
                                        Margin="0,0,0,14">
                                <TextBlock Text="推演参数"
                                           FontSize="20"
                                           FontWeight="Bold" />

                                <TextBlock Text="当前仅展示基础参数结构，后续可扩展为可编辑参数表。"
                                           Foreground="#BFD4F5"
                                           FontSize="14"
                                           Margin="0,8,0,0" />
                            </StackPanel>

                            <DataGrid Grid.Row="1"
                                      Style="{DynamicResource ModernDataGridStyle}"
                                      ItemsSource="{Binding Parameters}">

                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="参数名称"
                                                        Binding="{Binding Name}"
                                                        Width="160" />

                                    <DataGridTextColumn Header="参数值"
                                                        Binding="{Binding Value}"
                                                        Width="120" />

                                    <DataGridTextColumn Header="单位"
                                                        Binding="{Binding Unit}"
                                                        Width="80" />

                                    <DataGridTextColumn Header="说明"
                                                        Binding="{Binding Description}"
                                                        Width="*" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 底部状态栏 -->
                <Border Grid.Row="2"
                        Background="#CC1F2937"
                        CornerRadius="8"
                        Padding="12"
                        Margin="0,16,0,0">

                    <TextBlock Text="{Binding ModuleStatusText}"
                               Foreground="#F8FAFC"
                               FontSize="14"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>