<UserControl x:Class="CombatSimulation.Views.TargetDamageTreeInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:CombatSimulation.Models"
             xmlns:controls="clr-namespace:CombatSimulation.Controls"
             xmlns:util="clr-namespace:CombatSimulation.Util">

    <!-- 不设置 DataContext，继承 TargetInfoView 的 TargetInfoViewModel。 -->
    <UserControl.Resources>
        <util:BindingProxy x:Key="DamageTreeViewModelProxy" Data="{Binding}" />

        <Style x:Key="DamageTreeTextActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="76" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#F6E84A" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#FF3B30" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Foreground" Value="#FF3B30" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#64748B" /></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DamageTreeActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border></ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DamageTreeAddActionButtonStyle" TargetType="Button" BasedOn="{StaticResource DamageTreeActionButtonStyle}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding CanAddChild}" Value="False"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModifyIconStyle" TargetType="Image">
            <Setter Property="Source" Value="/Resources/Images/btnMod_L.png" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Source" Value="/Resources/Images/btnMod.png" /></DataTrigger>
                <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Source" Value="/Resources/Images/btnMod.png" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DeleteIconStyle" TargetType="Image">
            <Setter Property="Source" Value="/Resources/Images/btnDel_L.png" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Source" Value="/Resources/Images/btnDel.png" /></DataTrigger>
                <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Source" Value="/Resources/Images/btnDel.png" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AddIconStyle" TargetType="Image">
            <Setter Property="Source" Value="/Resources/Images/btnAdd_L.png" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Source" Value="/Resources/Images/btnAdd.png" /></DataTrigger>
                <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True"><Setter Property="Source" Value="/Resources/Images/btnAdd.png" /></DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DamageTreeContextMenuStyle" TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="#EE0F172A" />
            <Setter Property="BorderBrush" Value="#3B4A5F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DamageTreeMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="170" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#EE0F172A" />
            <Setter Property="Foreground" Value="#EAF6FF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="MenuItemBorder" Background="{TemplateBinding Background}" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="{TemplateBinding Padding}">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center" TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuItemBorder" Property="Background" Value="#CC13324C" /><Setter Property="Foreground" Value="#FFFF00" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DamageTreeViewExpanderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <Path x:Name="Arrow"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 2 1 L 2 9 L 7 5 Z"
                                  Fill="#9CA3AF"
                                  SnapsToDevicePixels="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="Data" Value="M 1 3 L 9 3 L 5 8 Z" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Fill" Value="#F6E84A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="DamageGraphTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="True" />
            <Setter Property="Foreground" Value="#EAF6FF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,2" />
        </Style>

        <Style x:Key="DamageTreeItemStyle" TargetType="TreeViewItem">
            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
            <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}" />
            <Setter Property="Foreground" Value="#EAF6FF" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TreeViewItem">
                        <!-- 使用目标结构模块同类模板，覆盖系统默认白色选中态，避免节点失焦后被白底覆盖。 -->
                        <StackPanel Background="Transparent">
                            <Border x:Name="SelectionBorder" Background="Transparent" Padding="0" SnapsToDevicePixels="True">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <ToggleButton x:Name="Expander"
                                                  Grid.Column="0"
                                                  Style="{StaticResource DamageTreeViewExpanderToggleStyle}"
                                                  IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                                  ClickMode="Press" />

                                    <ContentPresenter x:Name="PART_Header"
                                                      Grid.Column="1"
                                                      ContentSource="Header"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                </Grid>
                            </Border>

                            <ItemsPresenter x:Name="ItemsHost" Margin="16,0,0,0" />
                        </StackPanel>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="False">
                                <Setter TargetName="ItemsHost" Property="Visibility" Value="Collapsed" />
                            </Trigger>
                            <Trigger Property="HasItems" Value="False">
                                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionBorder" Property="Background" Value="#331A4A72" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="SelectionBorder" Property="Background" Value="#8840739B" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#668EA9BF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DamageDetailRowTemplate" DataType="{x:Type models:TargetDetailRow}">
            <Grid MinHeight="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="#9913324C" BorderBrush="#334155" BorderThickness="0,0,1,1" Padding="8,4">
                    <TextBlock Text="{Binding Label}" Foreground="#EAF6FF" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                </Border>
                <Border Grid.Column="1" Background="#80102033" BorderBrush="#334155" BorderThickness="0,0,0,1" Padding="8,4">
                    <TextBlock Text="{Binding Value}" Foreground="#EAF6FF" FontSize="15" VerticalAlignment="Center" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </DataTemplate>

        <HierarchicalDataTemplate DataType="{x:Type models:DamageTreeNodeItem}" ItemsSource="{Binding Children}">
            <Grid Margin="0,1" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding NodeName}" Foreground="#EAF6FF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Border Background="#331E90FF" BorderBrush="#668FB7FF" BorderThickness="1" Margin="8,0,0,0" Padding="5,0" CornerRadius="4">
                        <TextBlock Text="{Binding RelationDisplayText}" Foreground="#BFD4F5" FontSize="12" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Button Style="{StaticResource DamageTreeActionButtonStyle}" ToolTip="修改" Command="{Binding Data.RequestModifyDamageTreeNodeCommand, Source={StaticResource DamageTreeViewModelProxy}}" CommandParameter="{Binding}">
                        <Image Style="{StaticResource ModifyIconStyle}" />
                    </Button>
                    <Button Style="{StaticResource DamageTreeActionButtonStyle}" ToolTip="删除" Command="{Binding Data.RequestDeleteDamageTreeNodeCommand, Source={StaticResource DamageTreeViewModelProxy}}" CommandParameter="{Binding}">
                        <Image Style="{StaticResource DeleteIconStyle}" />
                    </Button>
                    <Button Style="{StaticResource DamageTreeAddActionButtonStyle}" ToolTip="添加子节点" Click="OnOpenAddContextMenuClicked">
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Style="{StaticResource DamageTreeContextMenuStyle}">
                                <MenuItem Header="中间节点" Style="{StaticResource DamageTreeMenuItemStyle}" Command="{Binding Data.RequestAddDamageMiddleNodeCommand, Source={StaticResource DamageTreeViewModelProxy}}" CommandParameter="{Binding}" />
                                <MenuItem Header="叶子节点" Style="{StaticResource DamageTreeMenuItemStyle}" Command="{Binding Data.RequestAddDamageLeafNodeCommand, Source={StaticResource DamageTreeViewModelProxy}}" CommandParameter="{Binding}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Image Style="{StaticResource AddIconStyle}" />
                    </Button>
                </StackPanel>
            </Grid>
        </HierarchicalDataTemplate>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#B90F172A" BorderBrush="#223B4A5F" BorderThickness="1" Padding="10,8" ClipToBounds="True">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="毁伤树信息" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="{Binding SelectedTarget.Name}" Foreground="#BFD4F5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="添加毁伤树" Width="86" Style="{StaticResource DamageTreeTextActionButtonStyle}" Command="{Binding RequestAddDamageTreeCommand}" />
                        <Button Content="修改毁伤树" Width="86" Style="{StaticResource DamageTreeTextActionButtonStyle}" Command="{Binding RequestModifyDamageTreeCommand}" />
                        <Button Content="删除毁伤树" Width="86" Style="{StaticResource DamageTreeTextActionButtonStyle}" Command="{Binding RequestDeleteDamageTreeCommand}" />
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding DamageTrees}"
                              SelectedItem="{Binding SelectedDamageTree, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              Margin="0,10,0,0"
                              Style="{DynamicResource TargetTypeComboBoxStyle}"
                              ItemContainerStyle="{DynamicResource TargetTypeComboBoxItemStyle}" />
                </StackPanel>

                <TreeView ItemsSource="{Binding SelectedDamageTree.RootNodes}"
                          SelectedItemChanged="OnDamageTreeSelectedItemChanged"
                          ItemContainerStyle="{StaticResource DamageTreeItemStyle}"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="#EAF6FF"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="180" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#9910273D" BorderBrush="#223B4A5F" BorderThickness="1" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="毁伤树逻辑预览图" FontSize="20" FontWeight="Bold" />
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,18,0,0" Background="#660F172A" BorderBrush="#334155" BorderThickness="1" Padding="14">
                        <!--
                            右侧预览区改为代码动态绘制的 Grid。
                            该结构与旧实现中的 DamageTreeShow 对齐：小树自适应填充，大树自动放入 ScrollViewer。
                        -->
                        <Grid x:Name="DamageTreeShow"
                              ClipToBounds="True"
                              SizeChanged="OnDamageTreeShowSizeChanged" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#A60B1120" BorderBrush="#3B4A5F" BorderThickness="1,0,1,1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="28" Background="#CC13324C" Padding="8,0">
                        <TextBlock Text="毁伤节点详情" Foreground="#EAF6FF" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SelectedDamageNodeDetailRows}" ItemTemplate="{StaticResource DamageDetailRowTemplate}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
