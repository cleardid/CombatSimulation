<UserControl x:Class="CombatSimulation.Views.TargetDamageTreeInfoView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:CombatSimulation.Models"
             xmlns:controls="clr-namespace:CombatSimulation.Controls"
             xmlns:util="clr-namespace:CombatSimulation.Util">

    <!-- 不设置 DataContext，继承 TargetInfoView 的 TargetInfoViewModel。 -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Resources/Styles/TargetDamageTreeInfoViewStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

        <util:BindingProxy x:Key="DamageTreeViewModelProxy" Data="{Binding}" />

        <HierarchicalDataTemplate DataType="{x:Type models:DamageTreeNodeItem}" ItemsSource="{Binding Children}">
            <Grid Margin="0,1" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="{Binding NodeName}" Foreground="#EAF6FF" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Border Background="#331E90FF" BorderBrush="#668FB7FF" BorderThickness="1" Margin="8,0,0,0" Padding="5,0" CornerRadius="4">
                        <TextBlock Text="{Binding RelationDisplayText}" Foreground="#BFD4F5" FontSize="12" />
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Button Style="{StaticResource DamageTreeActionButtonStyle}" ToolTip="修改" Command="{Binding Data.RequestModifyDamageTreeNodeCommand, Source={StaticResource DamageTreeViewModelProxy}}" CommandParameter="{Binding}">
                        <Image Style="{StaticResource ModifyIconStyle}" />
                    </Button>
                    <Button Style="{StaticResource DamageTreeActionButtonStyle}" ToolTip="删除" Command="{Binding Data.RequestDeleteDamageTreeNodeCommand, Source={StaticResource DamageTreeViewModelProxy}}" CommandParameter="{Binding}">
                        <Image Style="{StaticResource DeleteIconStyle}" />
                    </Button>
                    <Button Style="{StaticResource DamageTreeAddActionButtonStyle}" ToolTip="添加子节点" Click="OnOpenAddContextMenuClicked">
                        <Button.ContextMenu>
                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" Style="{StaticResource DamageTreeContextMenuStyle}">
                                <MenuItem Header="中间节点" Style="{StaticResource DamageTreeMenuItemStyle}" Command="{Binding Data.RequestAddDamageMiddleNodeCommand, Source={StaticResource DamageTreeViewModelProxy}}" CommandParameter="{Binding}" />
                                <MenuItem Header="叶子节点" Style="{StaticResource DamageTreeMenuItemStyle}" Command="{Binding Data.RequestAddDamageLeafNodeCommand, Source={StaticResource DamageTreeViewModelProxy}}" CommandParameter="{Binding}" />
                            </ContextMenu>
                        </Button.ContextMenu>
                        <Image Style="{StaticResource AddIconStyle}" />
                    </Button>
                </StackPanel>
            </Grid>
        </HierarchicalDataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="390" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#B90F172A" BorderBrush="#223B4A5F" BorderThickness="1" Padding="10,8" ClipToBounds="True">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBlock Text="毁伤树信息" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="{Binding SelectedTarget.Name}" Foreground="#BFD4F5" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <Button Content="添加毁伤树" Width="86" Style="{StaticResource DamageTreeTextActionButtonStyle}" Command="{Binding RequestAddDamageTreeCommand}" />
                        <Button Content="修改毁伤树" Width="86" Style="{StaticResource DamageTreeTextActionButtonStyle}" Command="{Binding RequestModifyDamageTreeCommand}" />
                        <Button Content="删除毁伤树" Width="86" Style="{StaticResource DamageTreeTextActionButtonStyle}" Command="{Binding RequestDeleteDamageTreeCommand}" />
                    </StackPanel>
                    <ComboBox ItemsSource="{Binding DamageTrees}"
                              SelectedItem="{Binding SelectedDamageTree, Mode=TwoWay}"
                              DisplayMemberPath="DisplayName"
                              Margin="0,10,0,0"
                              Style="{DynamicResource TargetTypeComboBoxStyle}"
                              ItemContainerStyle="{DynamicResource TargetTypeComboBoxItemStyle}" />
                </StackPanel>

                <TreeView ItemsSource="{Binding SelectedDamageTree.RootNodes}"
                          SelectedItemChanged="OnDamageTreeSelectedItemChanged"
                          ItemContainerStyle="{StaticResource DamageTreeItemStyle}"
                          Background="Transparent"
                          BorderThickness="0"
                          Foreground="#EAF6FF"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" Margin="12,0,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="180" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#9910273D" BorderBrush="#223B4A5F" BorderThickness="1" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="毁伤树逻辑预览图"
                                   FontSize="20"
                                   FontWeight="Bold" />
                        <Button Grid.Column="1"
                                Content="导出图片"
                                Width="86"
                                Style="{StaticResource DamageTreeTextActionButtonStyle}"
                                Click="OnExportDamageTreeImageClicked" />
                    </Grid>

                    <Border Grid.Row="1" Margin="0,18,0,0" Background="#660F172A" BorderBrush="#334155" BorderThickness="1" Padding="14">
                        <!--
                            毁伤树逻辑预览区。
                            外层 ScrollViewer 固定在 XAML 中，避免代码动态嵌套 ScrollViewer 后横向滚动条测量异常。
                            内层 DamageTreePreviewCanvas 用于提供稳定的滚动内容尺寸；DamageTreeShow 只负责承载事件框、逻辑门和连线。
                            按住 Ctrl 后滚动鼠标滚轮，可以对整个预览图进行缩放。
                        -->
                        <ScrollViewer x:Name="DamageTreePreviewScrollViewer"
                                      HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalContentAlignment="Stretch"
                                      CanContentScroll="False"
                                      PanningMode="Both"
                                      Background="Transparent"
                                      ClipToBounds="True"
                                      Focusable="True"
                                      PreviewMouseWheel="OnDamageTreePreviewMouseWheel">
                            <ScrollViewer.Resources>
                                <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}"
                                                 Color="Transparent" />
                            </ScrollViewer.Resources>

                            <Grid MinWidth="{Binding ViewportWidth, ElementName=DamageTreePreviewScrollViewer}"
                                  MinHeight="{Binding ViewportHeight, ElementName=DamageTreePreviewScrollViewer}"
                                  Background="Transparent">
                                <controls:DamageTreeGraphView x:Name="DamageTreeShow"
                                                              RootNodes="{Binding SelectedDamageTree.RootNodes}"
                                                              SelectedNode="{Binding SelectedDamageTreeNode}"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Top" />
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="#A60B1120" BorderBrush="#3B4A5F" BorderThickness="1,0,1,1">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Height="28" Background="#CC13324C" Padding="8,0">
                        <TextBlock Text="毁伤节点详情" Foreground="#EAF6FF" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding SelectedDamageNodeDetailRows}" ItemTemplate="{StaticResource DamageDetailRowTemplate}" />
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
