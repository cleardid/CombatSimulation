<Window x:Class="CombatSimulation.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CombatSimulation.Views"
        Title="作战推演"
        WindowStyle="None" 
        ResizeMode="NoResize"
        WindowState="Maximized"
        Background="Black"
        FontFamily="Microsoft YaHei UI"
        TextElement.Foreground="#F8FAFC"
        TextElement.FontSize="14"
        TextElement.FontWeight="Regular">
    <!-- WindowStyle="None" 去掉系统标题栏 -->
    <!-- ResizeMode="NoResize" 禁止用户拖动改变窗口大小 -->
    <!-- WindowState="Maximized" 程序启动后默认最大化 -->
    <!-- Background="Black" 设置窗口默认背景色，作为背景图未加载时的兜底颜色 -->
    <!-- FontFamily="Microsoft YaHei UI" 设置窗口内控件默认字体为微软雅黑 UI -->

    <!-- 当前窗口的资源字典：把当前窗口中反复使用的样式、颜色、模板等内容集中定义起来，后面控件通过 StaticResource 引用，避免重复写大量属性-->
    <Window.Resources>
        <ResourceDictionary Source="Resources/Styles/MainWindowStyles.xaml" />
    </Window.Resources>

    <Grid>
        <!--页面背景-->
        <Grid.Background>
            <ImageBrush ImageSource="pack://application:,,,/Resources/Images/pop.png"
                        Stretch="UniformToFill"
                        AlignmentX="Center"
                        AlignmentY="Center" />
        </Grid.Background>

        <Grid Background="#A60B1120">
            <!--将页面拆分为两行-->
            <Grid.RowDefinitions>
                <RowDefinition Height="72" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--将页面拆分为两列-->
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.ColumnSpan="2"
                       Text="典型装甲作战推演仿真平台"
                       FontSize="30"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Margin="24,0,0,0" />

            <Button Grid.Row="0"
                    Grid.ColumnSpan="2"
                    Content="×"
                    Style="{StaticResource CloseButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,16,22,0"
                    Command="{Binding CloseWindowCommand}" />

            <!--第二行内容-->
            <Border Grid.Row="1"
                    Grid.Column="0"
                    Background="#B90F172A"
                    BorderBrush="#223B4A5F"
                    BorderThickness="0,1,1,0"
                    Padding="22,10,18,20">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <ToggleButton Content="目标信息"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Style="{StaticResource NavButtonStyle}"
                                IsChecked="{Binding IsTargetInfoSelected, Mode=OneWay}"
                                Command="{Binding ShowTargetInfoCommand}" />

                        <ToggleButton Content="推演设定"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Style="{StaticResource NavButtonStyle}"
                                IsChecked="{Binding IsDeductionSettingSelected, Mode=OneWay}"
                                Command="{Binding ShowDeductionSettingCommand}" />

                        <ToggleButton Content="作战推演"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Style="{StaticResource NavButtonStyle}"
                                IsChecked="{Binding IsCombatDeductionSelected, Mode=OneWay}"
                                Command="{Binding ShowCombatDeductionCommand}" />
                    </StackPanel>

                    <Border Grid.Row="2"
                            Background="#CC1F2937"
                            CornerRadius="8"
                            Padding="12">
                        <TextBlock Text="{Binding CurrentModuleText}"
                                   FontSize="14"
                                   LineHeight="24" />
                    </Border>
                </Grid>
            </Border>

            <Grid Grid.Row="1"
                  Grid.Column="1"
                  Margin="20,0,20,20">

                <!-- 第一模块：目标信息 -->
                <Grid Visibility="{Binding TargetInfoVisibility}">
                    <views:TargetInfoView x:Name="TargetInfoModule" />
                </Grid>

                <!-- 第二模块：推演设定 -->
                <Grid Visibility="{Binding DeductionSettingVisibility}">
                    <views:DeductionSettingView />
                </Grid>

                <!-- 第三模块：作战推演 -->
                <Grid Visibility="{Binding CombatDeductionVisibility}">
                    <views:CombatDeductionView />
                </Grid>

            </Grid>
        </Grid>
    </Grid>
</Window>