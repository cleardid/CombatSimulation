<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:models="clr-namespace:CombatSimulation.Models">
        <Style x:Key="TreeActionButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SystemOrPartActionButtonStyle" TargetType="Button" BasedOn="{StaticResource TreeActionButtonStyle}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding NodeType}" Value="目标">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AddActionButtonStyle" TargetType="Button" BasedOn="{StaticResource TreeActionButtonStyle}">
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding NodeType}" Value="系统">
                    <Setter Property="Visibility" Value="Visible" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ModifyIconStyle" TargetType="Image">
            <Setter Property="Source" Value="/Resources/Images/btnMod_L.png" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Source" Value="/Resources/Images/btnMod.png" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Source" Value="/Resources/Images/btnMod.png" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DeleteIconStyle" TargetType="Image">
            <Setter Property="Source" Value="/Resources/Images/btnDel_L.png" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Source" Value="/Resources/Images/btnDel.png" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Source" Value="/Resources/Images/btnDel.png" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AddIconStyle" TargetType="Image">
            <Setter Property="Source" Value="/Resources/Images/btnAdd_L.png" />
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Source" Value="/Resources/Images/btnAdd.png" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                    <Setter Property="Source" Value="/Resources/Images/btnAdd.png" />
                </DataTrigger>
            </Style.Triggers>
        </Style>


        <Style x:Key="TreeViewExpanderToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="14" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsTabStop" Value="False" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border Background="Transparent">
                            <Path x:Name="Arrow"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Data="M 2 1 L 2 9 L 7 5 Z"
                                  Fill="#9CA3AF"
                                  SnapsToDevicePixels="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Arrow" Property="Data" Value="M 1 3 L 9 3 L 5 8 Z" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Arrow" Property="Fill" Value="#F6E84A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TreeAddContextMenuStyle" TargetType="{x:Type ContextMenu}">
            <Setter Property="Background" Value="#EE0F172A" />
            <Setter Property="BorderBrush" Value="#3B4A5F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ContextMenu}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TreeAddMenuItemStyle" TargetType="{x:Type MenuItem}">
            <Setter Property="OverridesDefaultStyle" Value="True" />
            <Setter Property="Height" Value="30" />
            <Setter Property="MinWidth" Value="230" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="#EE0F172A" />
            <Setter Property="Foreground" Value="#EAF6FF" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type MenuItem}">
                        <Border x:Name="MenuItemBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#334155"
                                BorderThickness="0,0,0,1"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter ContentSource="Header"
                                              VerticalAlignment="Center"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuItemBorder" Property="Background" Value="#CC13324C" />
                                <Setter Property="Foreground" Value="#FFFF00" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#8099B3C8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <Style x:Key="DetailGroupBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="#B90F172A" />
            <Setter Property="BorderBrush" Value="#3B4A5F" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="DetailHeaderTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#EAF6FF" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FirstDetailTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DetailHeaderTextStyle}">
            <Setter Property="Text" Value="部件基础信息" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedStructureNode.NodeType}" Value="系统">
                    <Setter Property="Text" Value="系统基础信息" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedStructureNode.NodeType}" Value="目标">
                    <Setter Property="Text" Value="目标基础信息" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondDetailTitleTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DetailHeaderTextStyle}">
            <Setter Property="Text" Value="结构信息(单位:mm)" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedStructureNode.NodeType}" Value="系统">
                    <Setter Property="Text" Value="系统结构信息" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedStructureNode.NodeType}" Value="目标">
                    <Setter Property="Text" Value="目标结构信息" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="PartOnlyDetailGroupBorderStyle" TargetType="Border" BasedOn="{StaticResource DetailGroupBorderStyle}">
            <Setter Property="Visibility" Value="Visible" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedStructureNode.NodeType}" Value="系统">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SelectedStructureNode.NodeType}" Value="目标">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="DetailRowTemplate" DataType="{x:Type models:TargetDetailRow}">
            <Grid MinHeight="34">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="#9913324C"
                        BorderBrush="#334155"
                        BorderThickness="0,0,1,1"
                        Padding="8,4">
                    <TextBlock Text="{Binding Label}"
                               Foreground="#EAF6FF"
                               FontSize="15"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Border>

                <Border Grid.Column="1"
                        Background="#80102033"
                        BorderBrush="#334155"
                        BorderThickness="0,0,0,1"
                        Padding="8,4">
                    <TextBlock Text="{Binding Value}"
                               Foreground="#EAF6FF"
                               FontSize="15"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>
        </DataTemplate>
</ResourceDictionary>
